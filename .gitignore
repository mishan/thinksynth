*.o
*.so
*.a
*.dt

Makefile
# hand-written, not generated by configure
!scripts/Makefile

# CMake builds out of source, so one pattern covers it. Everything below this
# line down to the autotools section goes away with configure.ac.
build/
build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# The harnesses, by pattern rather than by name. The list used to be written
# out one binary at a time, and twice a new harness was added without its line
# -- dspnew and dsplayout both got committed as multi-megabyte ELF files. A
# pattern cannot be forgotten. Sources are re-admitted below.
scripts/dsp*
!scripts/*.cpp
!scripts/*.h
!scripts/*.sh

libthink/libthink.so.*
libthink/thinklang.cpp
libthink/thinklang.h
libthink/thinklang.hpp
libthink/thinklex.cpp

docs/thinksynth.1
etc/thinkrc
src/thinksynth
plugins/plugin-common.mk

# Autotools droppings, anchored to the top of the tree. Unanchored, these
# match at any depth -- `config.h.in' silently swallowed cmake/config.h.in,
# which git add then skipped without a word. All of this goes when
# configure.ac does.
/configure
/config.log
/config.status
/config.h
/config.h.in
/build.mk
/autom4te.cache
/aclocal.m4
/configure~

# Editor droppings. An emacs autosave and a lock symlink for two of the DSPs
# got committed once; the lock files are dangling symlinks to a user@host that
# means nothing to anyone else.
\#*\#
.\#*
*~
.*.swp
