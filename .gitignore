*.o
*.so
# *.so does not match libthink.so.6.0 -- the name has to *end* in .so.
libthink/libthink.so.*
*.a

# CMake builds out of source, so one pattern covers most of it.
build/
build-*/
_deps/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
config.h

# The harnesses, by pattern rather than by name. The list used to be written
# out one binary at a time, and twice a new harness was added without its line
# -- dspnew and dsplayout both got committed as multi-megabyte ELF files. A
# pattern cannot be forgotten. Sources are re-admitted below.
scripts/dsp*
!scripts/*.cpp
!scripts/*.h
!scripts/*.sh

src/thinksynth

# Editor droppings. An emacs autosave and a lock symlink for two of the DSPs
# got committed once; the lock files are dangling symlinks to a user@host that
# means nothing to anyone else.
\#*\#
.\#*
*~
.*.swp

# Flatpak. flatpak-builder puts a multi-gigabyte object cache in
# .flatpak-builder/ and an OSTree repo in repo/, and the bundle itself is a
# build artefact -- none of it belongs in the tree. Left out of .gitignore,
# the first `git add -A' after a local flatpak build commits the lot.
.flatpak-builder/
build-flatpak/
repo/
*.flatpak
