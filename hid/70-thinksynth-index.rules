# Lets whoever is at the seat read a Valve Index controller, wired or through
# a Watchman dongle, which thinksynth plays as an instrument. Copy it to
# /etc/udev/rules.d/ and plug the controller or dongle in again.
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="2300", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="2101", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="2102", TAG+="uaccess"
