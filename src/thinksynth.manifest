<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest embedded into thinksynth.exe; see thinksynth.rc.in.

     asInvoker      run with the privileges of whoever started it. thinksynth
                    is not an installer and writes only to the user's own
                    config directory, so it should never raise a UAC prompt.

     supportedOS    without these, Windows lies to the version APIs and caps
                    what it reports at Windows 8, on the assumption that an
                    unmanifested binary is old enough to be confused by the
                    truth.

     longPathAware  paths over 260 characters. A patch or DSP can be saved
                    anywhere the user likes, and "anywhere" on Windows is
                    often several folders deep already.

     dpiAware       per-monitor v2. GTK draws its own widgets and handles
                    scaling itself; without this Windows bitmap-stretches the
                    whole window on a high-DPI display, which turns crisp text
                    into a blur. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- 10 and 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- 8.1 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/> <!-- 8 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/> <!-- 7 -->
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
