BINARY = thinksynth

bindir=@bindir@
prefix=@prefix@

all: thinksynth

so := @SHARED_SUFFIX@
soname = @lib_revision@

include ../build.mk

PICFLAGS =

# Find libthink next to the binary rather than only through the system loader
# path. -L is link-time only, so without this the freshly built thinksynth
# would go looking for libthink.so.@lib_revision@ in /usr/local/lib and friends
# -- picking up a stale installed copy if the soname happened to match, or
# failing outright if it did not.
#
# $$ORIGIN is resolved by the loader against the binary's own location, so this
# works from the build tree and after `make install' without baking in an
# absolute path. --enable-new-dtags makes it a RUNPATH, which LD_LIBRARY_PATH
# still overrides.
RPATH = -Wl,-rpath,'$$ORIGIN/../libthink' -Wl,-rpath,'$$ORIGIN/../lib' \
        -Wl,--enable-new-dtags

LDFLAGS += @LIBS@ @GTKMM_LIBS@ @GTHREAD_LIBS@ -L../libthink -lthink $(RPATH) @JACK_LIBS@ @ALSA_LIBS@
INCLUDES = -I.. -I../libthink @GTKMM_CFLAGS@ @JACK_CFLAGS@ @ALSA_CFLAGS@
MAINOBJS = main.o NodeGraph.o NodeLayout.o @GTH_ALSA@ @GTH_JACK_AUDIO@ gthPrefs.o gthPatchfile.o gthDummyAudio.o

thinksynth: ../libthink/libthink$(so).$(soname) gui/gth.a $(MAINOBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(MAINOBJS) $(LDFLAGS) gui/gth.a

gui/gth.a: 
	$(MAKE) -C gui gth.a

../libthink/libthink$(so).$(soname):
	$(MAKE) -C ../libthink

clean::
	rm -f thinksynth
	$(MAKE) -C gui $@

distclean::
	rm -f Makefile
	$(MAKE) -C gui $@

install:
	mkdir -p $(DESTDIR)$(bindir)
	cp -f thinksynth $(DESTDIR)$(bindir)

uninstall:
	rm -f $(DESTDIR)$(bindir)/thinksynth

.PHONY: gui/gth.a ../libthink/libthink$(so).$(soname)
