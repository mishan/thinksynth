/* config.h -- generated by CMake from cmake/config.h.in
 *
 * Replaces the autoheader-generated config.h. Only the macros the tree
 * actually references are here; configure.ac also emitted PREFIX, RETSIGTYPE,
 * STDC_HEADERS and YYTEXT_POINTER, none of which is used anywhere.
 */

#ifndef THINK_CONFIG_H
#define THINK_CONFIG_H 1

#define PACKAGE_NAME    "@PROJECT_NAME@"
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define PACKAGE_STRING  "@PROJECT_NAME@ @PROJECT_VERSION@"

/* Which one main.cpp picks when -d is not given. */
#define DEFAULT_OUTPUT "@THINK_DEFAULT_OUTPUT@"

/* Dynamic loader. */
#cmakedefine HAVE_DLFCN_H 1
#cmakedefine HAVE_DLERROR 1

/* misc/wlan, which is not in the default plugin set. */
#cmakedefine HAVE_IWLIB_H 1

/* Platform. */
#cmakedefine USING_DARWIN 1
#cmakedefine USING_FREEBSD 1

/* signal handler typedef, probed in the top-level CMakeLists.txt. */
#cmakedefine USE_SIG_T 1
#cmakedefine GUESS_SIG_T 1

/* thEndian.h. */
#cmakedefine WORDS_BIGENDIAN 1

/* --enable-debug. */
#cmakedefine USE_DEBUG 1

/* Install locations. Trailing slashes are load-bearing: the sources
   concatenate a bare filename onto these. */
#define PLUGIN_SUFFIX    "@THINK_PLUGIN_SUFFIX@"
#define PLUGIN_PATH      "@THINK_PLUGIN_PATH@"
#define DSP_PATH         "@THINK_DSP_PATH@"
#define PATCH_PATH       "@THINK_PATCH_PATH@"

/* The application identity: GApplication id, desktop entry stem, macOS bundle
   identifier and Flatpak app-id, all one string. See CMakeLists.txt. */
#define THINK_APP_ID     "@THINK_APP_ID@"

#endif /* THINK_CONFIG_H */
