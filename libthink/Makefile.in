libdir =@libdir@
includedir = @includedir@
prefix = @prefix@

so := @SHARED_SUFFIX@

all: libthink$(so) libthink.a 

include ../build.mk

soname := @lib_revision@

PICFLAGS := -fPIC
INCLUDES := -I..
CXXFLAGS += @SIGC_CFLAGS@
LDFLAGS += @LIBS@ @SIGC_LIBS@
LIB_LDFLAGS = @LIB_LDFLAGS@
LDCONFIG := @LDCONFIG@

LIBOBJS = \
	@NSMODULE_DL_O@ \
	thinklang.o \
	thinklex.o \
	thArg.o \
	thMidiChan.o \
	thMidiNote.o \
	thSynthTree.o \
	thNode.o \
	thPlugin.o \
	thPluginManager.o \
	thMidiControllerConnection.o \
	thMidiController.o \
	thSynth.o \
	thUtil.o

libthink$(so): libthink$(so).$(soname)
	ln -sf libthink$(so).$(soname) libthink$(so)

libthink$(so).$(soname): $(LIBOBJS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $(LIB_LDFLAGS) -o $@ $(LIBOBJS)

libthink.a: $(LIBOBJS)
	ar crsv $@ $(LIBOBJS)

# bison emits the parser and its header together. The header has to be a real
# target: the old `thinklang.hpp:' stub relied on build.mk renaming whatever
# bison produced after the fact, which stopped working with bison >= 3 (the
# generated .cpp #includes the header under the name bison was told to use).
thinklang.cpp: thinklang.yy
	@YACC@ --defines=thinklang.h -o $@ $<

thinklang.h: thinklang.cpp
	@test -f $@ || { rm -f thinklang.cpp; $(MAKE) thinklang.cpp; }

# was `thinklex.ll thinklang.o' -- the lexer needs the parser's token
# definitions, not the compiled object.
thinklex.cpp: thinklex.ll thinklang.h
	@LEX@ -o$@ thinklex.ll

# Generated sources are implicit-rule intermediates; without this make deletes
# them at the end of every build and regenerates them on the next one.
.SECONDARY: thinklang.cpp thinklang.h thinklex.cpp

clean::
	rm -f libthink.so.$(soname) libthink$(so) libthink.a 

distclean::
	rm -f thinklang.cpp thinklex.cpp thinklang.hpp thinklang.h Makefile

install:
	mkdir -p $(DESTDIR)$(libdir)
	cp -f libthink$(so).$(soname) $(DESTDIR)$(libdir)
	cp -f libthink.a $(DESTDIR)$(libdir)
	ln -sf libthink$(so).$(soname) $(DESTDIR)$(libdir)/libthink$(so)
	mkdir -p $(DESTDIR)$(includedir)/libthink
	for header in $(wildcard *.h); do \
		install -m 644 $$header $(DESTDIR)$(includedir)/libthink/; \
	done
# DESTDIR installs are probably for packaging, otherwise you're probably
# doing things correctly
ifeq (,$(DESTDIR))
	$(LDCONFIG) $(libdir)
endif

uninstall:
	rm -f $(DESTDIR)$(libdir)/libthink$(so).$(soname) $(DESTDIR)$(libdir)/libthink$(so) $(DESTDIR)$(libdir)/libthink.a
	rm -rf $(DESTDIR)$(includedir)/libthink
