# growth.gen -- two algorithms that plan ahead.
#
# The lsystem unfolds a plant grammar into a branching melody; evolve
# breeds a bass phrase toward its own taste, one generation per cycle.
# Both emit whole phrases into the future, so the piano roll's ghosted
# right half finally has something to say. Watch their stage boxes on
# the canvas: the contour is the plant, the climbing line is the search
# settling.
#
# Aim channel 3 at a plucky patch and channel 2 at a bass. Unpinned on
# purpose: evolve should wander differently every time. Pin a seed if
# you hear a take worth keeping.

name "Growth";
author "Misha Nasledov";
description "An L-system canopy over an evolving bass.";

@mutation = 0.08;
@mutation.widget = 1;
@mutation.min = 0;
@mutation.max = 0.5;
@mutation.label = "Mutation";

@leaps = 0.5;
@leaps.widget = 1;
@leaps.min = 0;
@leaps.max = 1;
@leaps.label = "Leap tax";

scale cpent "C3 D3 E3 G3 A3";

chain canopy {
    stage src gen::lsystem {
        axiom = "X";
        rules = "X=F[+X]F[-X], F=Fr";
        depth = 5;
        notes = "C4 D4 E4 G4 A4";
        step = 0.32 s; hold = 0.5 s; vel = 72;
    };
    stage soft xform::humanize { time = 0.015 s; vel = 6; };
    sink { channel = 3; };
};

chain roots {
    stage src gen::evolve {
        notes = cpent;
        length = 16; population = 24;
        mutate = @mutation; density = 0.55; smooth = @leaps;
        boredom = 0.45;
        step = 0.4 s; hold = 0.5 s; vel = 88;
    };
    sink { channel = 2; };
};
