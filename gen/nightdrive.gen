# nightdrive.gen -- synthwave on one graph: analog.dsp four ways.
#
# A hundred to the minute in A minor. Every pitched part is the same
# .dsp, `analog', set four ways -- the instruments below are
# patches/bass/OctaveBass, pads/AnalogStrings, brass/PolyBrass and
# leads/SyncLead written into the piece -- so what makes a bass a bass
# and a lead a lead is visible as a list of chanargs rather than hidden
# in four graphs.
#
# THE LEAD IS HARD-SYNCED. Its second oscillator restarts on every
# cycle of the first, a fifth up, and the filter envelope sweeps it two
# octaves down over the note: the pitch stays put and the formant
# falls, which is the sound. osc::blep corrects the restart the way it
# corrects a wrap, so the sweep does not alias its way down the keyboard.
#
# THE ECHO IS IN BEATS. fx/echo.dsp's `beats' times the delay from the
# piece's tempo through misc::tempo, so the dotted eighth stays a dotted
# eighth when the tempo control moves -- `Throw' is how many beats.
#
# THE STRINGS ARE A STRING MACHINE: three detuned saws through
# fx/ensemble.dsp, a slow sweep and a fast vibrato on every path.
#
# THE BASS DUCKS UNDER THE KICK: fx/comp.dsp with `side = kick', which
# turns it down when the kick plays rather than when a composer guesses
# it does. The octaves are xform::bassline's `o'.
#
# ONE WALK, THREE CHAINS, as in outrun.gen: the strings, the brass and
# the bass run gen::progression with the same seed. The lead is
# written out, two bars of call and two of answer.

name "Night Drive";
author "Misha Nasledov";
description "Synthwave on one graph: a hard-sync lead with a dotted-eighth echo in beats, octave bass ducked by the kick, ensemble strings and poly brass.";
category "The eighties";

tempo 100;
seed 1984;
meter 4;

# ---- the arrangement --------------------------------------------------

section intro   8 bars { lead = 0;  bass = 0;  brass = 0;  snare = 0;
                         hats = 0; };
section verse  16 bars { lead = 0;  brass = 0; };
section chorus 16 bars { strings = 0.8; };
section break   8 bars { kick = 0;  snare = 0;  hats = 0;  bass = 0;
                         brass = 0; };
section last   16 bars { strings = 0.8; };
section outro   8 bars { lead = 0;  brass = 0;  snare = 0;  bass = 0; };
section end;

@walk = 0.15;
@walk.widget = 1;
@walk.min = 0;
@walk.max = 0.6;
@walk.label = "Walk";

@throw = 0.75;
@throw.widget = 1;
@throw.min = 0.25;
@throw.max = 1.5;
@throw.label = "Throw (beats)";

scale amin "A2 B2 C3 D3 E3 F3 G3";

# The lead's ladder: degree 0 is E4.
scale hook "E4 F4 G4 A4 B4 C5 D5 E5 F5 G5 A5";

# ---- the mix ----------------------------------------------------------

effect "fx/glue.dsp" {
    ceiling = 0.88;
    makeup  = 4.5;
};

# ---- instruments ------------------------------------------------------

instrument kick {
    dsp  "kick909.dsp";
    amp  = 17;

    pitch = 190;
    floor = 48;
    sweep = 60 ms;
    decay = 340 ms;
    click = 0.4;
    drive = 2.2;
};

instrument snare {
    dsp  "snare.dsp";
    amp  = 28;

    color   = 1;
    tone    = 1500;
    res     = 0.45;
    a       = 1 ms;
    d       = 220 ms;
    tune    = 180;
    bd      = 90 ms;
    balance = 0.45;

    effect "fx/gate.dsp" {
        decay   = 0.86;
        size    = 1.2;
        damping = 3600;
        diffuse = 6 ms;
        hold    = 3.4;
        slam    = 70;
        mix     = 0.55;
    };
};

instrument hat {
    dsp  "hat.dsp";
    amp  = 14;

    color = 0;
    tone  = 8500;
    res   = 0.2;
    a     = 0.5 ms;
    clen  = 40 ms;
    olen  = 500 ms;
    pedal = 10 ms;
};

instrument bass {
    dsp  "analog.dsp";
    amp  = 34;

    wave1 = 0;  wave2 = 1;  semi2 = 0;  mix2 = 0.4;  pw = 0.5;
    sub = 0.5;  unison = 3;  spread = 0;  drift = 2;
    cutoff = 300;  res = 0.35;  envamt = 2500;  keytrack = 0.3;
    fa = 0 ms;  fd = 180 ms;  fs = 0.1;  fr = 100 ms;
    a = 1 ms;  d = 300 ms;  s = 0.7;  r = 100 ms;

    effect "fx/comp.dsp" {
        side = kick;
    };
};

instrument strings {
    dsp  "analog.dsp";
    amp  = 18;

    wave1 = 0;  wave2 = 0;  semi2 = 12;  mix2 = 0.35;
    sub = 0;  unison = 6;  spread = 0.8;  drift = 5;
    cutoff = 2500;  res = 0.1;  envamt = 0;  keytrack = 0.5;
    a = 400 ms;  d = 1000 ms;  s = 1;  r = 900 ms;

    effect "fx/ensemble.dsp" {
        mix = 0.6;
    };
};

instrument brass {
    dsp  "analog.dsp";
    amp  = 22;

    wave1 = 0;  wave2 = 0;  semi2 = 0;  mix2 = 0.5;
    sub = 0;  unison = 9;  spread = 0.6;  drift = 4;
    cutoff = 500;  res = 0.15;  envamt = 3500;  keytrack = 0.6;
    fa = 80 ms;  fd = 700 ms;  fs = 0.45;  fr = 300 ms;
    a = 30 ms;  d = 300 ms;  s = 0.85;  r = 250 ms;
};

instrument lead {
    dsp  "analog.dsp";
    amp  = 30;

    wave1 = 0;  wave2 = 0;  semi2 = 7;  mix2 = 1;
    sync = 1;  sweep = 24;
    sub = 0;  unison = 5;  spread = 0.5;  drift = 3;
    cutoff = 4000;  res = 0.2;  envamt = 3000;  keytrack = 0.5;
    fa = 0 ms;  fd = 600 ms;  fs = 0.3;  fr = 300 ms;
    a = 2 ms;  d = 400 ms;  s = 0.8;  r = 250 ms;

    effect "fx/echo.dsp" {
        beats    = @throw;
        feedback = 0.35;
        mix      = 0.25;
    };
};

# ---- the drums --------------------------------------------------------

chain kick {
    stage src gen::euclid {
        steps = 4;  fills = 4;  rotate = 0;
        notes = "C2";
        period = 1 beats;  hold = 0.25 beats;  vel = 112;
    };
    sink { instrument = kick; };
};

chain snare {
    stage src gen::euclid {
        steps = 4;  fills = 2;  rotate = 1;
        notes = "D2";
        period = 1 beats;  hold = 0.25 beats;  vel = 108;
    };
    sink { instrument = snare; };
};

chain hats {
    stage src gen::euclid {
        steps = 8;  fills = 8;  rotate = 0;
        notes = "F#3";
        period = 0.5 beats;  hold = 0.2 beats;  vel = 54;
    };
    stage a xform::accent {
        pattern = ".x.x.x.x";  grid = 0.5 beats;
        strong = 1.5;  weak = 1;
    };
    sink { instrument = hat; };
};

# ---- the chords -------------------------------------------------------

chain strings {
    stage src gen::progression {
        scale = amin;
        every = 4 beats;  hold = 3.8 beats;  vel = 80;
        phrase = 4;  wander = @walk;  seed = 17;
    };
    stage chord xform::harmonize {
        scale = amin;
        voices = 3;  step = 2;
        spread = 0 s;
        taper = 0.9;
        root = 1;  below = 0;
        lead = 1;  span = 12;
    };
    stage up xform::transpose { semitones = 12; };
    sink { instrument = strings; };
};

# The brass on the and of two and on four, the chord stabbed rather
# than held.
chain brass {
    stage src gen::progression {
        scale = amin;
        every = 4 beats;  hold = 3.8 beats;  vel = 80;
        phrase = 4;  wander = @walk;  seed = 17;
    };
    stage chord xform::harmonize {
        scale = amin;
        voices = 3;  step = 2;
        spread = 0.01 s;
        taper = 0.9;
        root = 1;  below = 0;
        lead = 1;  span = 12;
    };
    stage up xform::transpose { semitones = 12; };
    stage rhythm xform::bassline {
        scale = amin;
        pattern = "...r..r.";
        step = 0.5 beats;  hold = 0.4 beats;  vel = 96;
        octave = 0;  pass = 0;
    };
    sink { instrument = brass; };
};

chain bass {
    stage src gen::progression {
        scale = amin;
        every = 4 beats;  hold = 3.8 beats;  vel = 80;
        phrase = 4;  wander = @walk;  seed = 17;
    };
    stage b xform::bassline {
        scale = amin;
        pattern = "rorororo";
        step = 0.5 beats;  hold = 0.4 beats;  vel = 100;
        octave = -1;  pass = 0;
    };
    sink { instrument = bass; };
};

# ---- the lead ---------------------------------------------------------

# Two bars of call, two of answer, in eighths; `_' holds a note a step.
chain lead {
    stage src gen::lsystem {
        axiom = "+++F_++F_++F_-F-F -F___--F_+F_ F_++F_++F_++F_ -F_-F_-F_rr";
        depth = 0;
        notes = hook;
        step = 0.5 beats;  hold = 0.45 beats;  vel = 100;
    };
    sink { instrument = lead; };
};
