# thaw.gen -- the spectral nodes, one part each: chords sieved, a tune
# that freezes, and plucks smeared into a wash.
#
# The chords are frost.dsp, a bell whose strike is caught sixty
# milliseconds in by fft::freeze and held as a pad for as long as the
# chord lasts. They go through fx/sieve.dsp, fft::gate on the channel:
# open until Sieve, it thins them there until only the
# strongest partials whistle, and in Hollow it is inverted, so the notes
# are taken out and the shimmer between them is all that is left.
#
# The tune is rhodes.dsp through fx/freeze.dsp, and a row from gen::steps
# turns the freeze on for the last bar of every four: the tune stops on
# whatever it was playing as that bar begins, and that instant hangs over
# the bar until the freeze lets go.
#
# The plucks are pluck.dsp through fx/blur.dsp, which smears each
# frequency's level over Smear. In Smear, two and a half seconds, every
# attack swells in and every note lingers into the next, and the
# arpeggio is a wash of the chord rather than a line; in Sieve and
# Hollow, at 300 and 600 ms, they are plucks again with a soft edge.
#
# FOUR KNOBS, each set by every section, so the loop comes round to Thaw
# as it was: Shimmer is both freezes' `random', Smear the blur, Thin
# the sieve's threshold, and Hollow inverts it.
#
# D lydian, at sixty-six: D, B minor, G and A under a tune that leans on
# the raised fourth.
#
# The tune's chance rolls dice; the seed is pinned for it.
# Self-contained: open it and press Play.

name "Thaw";
author "Misha Nasledov";
description "The spectral nodes, one part each: frozen bell chords sieved thin and hollow, a tune that freezes on each phrase's last bar, and plucks blurred into a wash.";
category "Timbre as material";

tempo 66;
seed 1213;
meter 4;

@shimmer = 0;
@shimmer.widget = 1;
@shimmer.min = 0;
@shimmer.max = 1;
@shimmer.label = "Shimmer";

@smear = 40;
@smear.widget = 1;
@smear.min = 0;
@smear.max = 4000;
@smear.label = "Smear (ms)";

@thin = -90;
@thin.widget = 1;
@thin.min = -90;
@thin.max = -6;
@thin.label = "Thin (dB)";

@hollow = 0;
@hollow.widget = 1;
@hollow.min = 0;
@hollow.max = 1;
@hollow.values = "Off,On";
@hollow.label = "Hollow";

section still   8 bars { @shimmer = 0;    @smear = 40;   @thin = -90; @hollow = 0;
                         tune = 0;  hold = 0;  bass = 0;  pluck = 0; };
section thaw    8 bars { @shimmer = 0.25; @smear = 40;   @thin = -90; @hollow = 0;
                         pluck = 0; };
section smear   8 bars { @shimmer = 0.25; @smear = 2500; @thin = -90; @hollow = 0;
                         tune = 0; };
section sieve   8 bars { @shimmer = 0.25; @smear = 300;  @thin = -10; @hollow = 0; };
section hollow  8 bars { @shimmer = 0.8;  @smear = 600;  @thin = -12; @hollow = 1;
                         frost = 2; };
section loop thaw;

scale dlyd  "D3 E3 F#3 G#3 A3 B3 C#4";
scale roots "D3 B2 G2 A2";

effect "fx/space.dsp" {
    mix   = 0;
    decay = 6;
    size  = 1.6;
};

instrument frost {
    dsp    "frost.dsp";
    amp    = 23;
    send   = 0.45;
    random = @shimmer;
    fade   = 300 ms;
    r      = 1500 ms;

    effect "fx/sieve.dsp" {
        thresh = @thin;
        invert = @hollow;
        smooth = 80 ms;
    };
};

instrument tune {
    dsp  "rhodes.dsp";
    amp  = 39;
    send = 0.35;

    effect "fx/freeze.dsp" {
        size   = 4096;
        random = @shimmer;
        fade   = 250 ms;
    };
};

instrument pluck {
    dsp  "pluck.dsp";
    amp  = 25;
    send = 0.4;

    effect "fx/blur.dsp" {
        blur   = @smear ms;
        random = 0.3;
    };
};

instrument bass {
    dsp  "sub.dsp";
    amp  = 20;
};

# A chord every two bars, each of its notes a frost voice: each strike
# caught and held, and each note shimmering with its own seed.
chain frost {
    stage src gen::lsystem {
        axiom = "F+F+F+F";  depth = 0;  notes = roots;
        step = 8 beats;  hold = 7.8 beats;  vel = 76;
    };
    stage chord xform::harmonize {
        scale = dlyd;  voices = 3;  step = 2;  spread = 0.03 s;
        taper = 0.85;  root = 1;  below = 0;  lead = 1;  span = 12;
    };
    sink { instrument = frost; };
};

# Eighths, five of every eight, cycling a tune of thirty notes over the
# changes; a few left out, so no two times round are quite the same.
chain tune {
    stage src gen::euclid {
        steps = 8;  fills = 5;  rotate = 0;
        notes = "A4 C#5 E5 F#5 G#5  E5 F#5 A5 G#5 F#5  B4 D5 F#5 A5 G#5  F#5 D5 B4 C#5 D5  G4 B4 D5 G#5 F#5  E5 A4 C#5 E5 A5";
        period = 0.5 beats;  hold = 0.45 beats;  vel = 72;
    };
    stage c xform::chance { prob = 0.9; };
    sink { instrument = tune; };
};

# The freeze: off for three bars, on for the fourth.
chain hold {
    stage src gen::steps {
        values = "0 0 0 1";
        period = 4 beats;
    };
    sink { instrument = tune; chanarg = "fx.freeze"; };
};

# Sixteenths, six of every eight, up and down a seventh chord on each
# root of the changes, two bars on each: its six-note figure four times
# over.
chain pluck {
    stage src gen::euclid {
        steps = 8;  fills = 6;  rotate = 1;
        notes = "D5 F#5 A5 C#6 A5 F#5 D5 F#5 A5 C#6 A5 F#5 D5 F#5 A5 C#6 A5 F#5 D5 F#5 A5 C#6 A5 F#5  B4 D5 F#5 A5 F#5 D5 B4 D5 F#5 A5 F#5 D5 B4 D5 F#5 A5 F#5 D5 B4 D5 F#5 A5 F#5 D5  G4 B4 D5 F#5 D5 B4 G4 B4 D5 F#5 D5 B4 G4 B4 D5 F#5 D5 B4 G4 B4 D5 F#5 D5 B4  A4 C#5 E5 G#5 E5 C#5 A4 C#5 E5 G#5 E5 C#5 A4 C#5 E5 G#5 E5 C#5 A4 C#5 E5 G#5 E5 C#5";
        period = 0.25 beats;  hold = 0.2 beats;  vel = 64;
    };
    sink { instrument = pluck; };
};

chain bass {
    stage src gen::lsystem {
        axiom = "F+F+F+F";  depth = 0;  notes = "D2 B1 G1 A1";
        step = 8 beats;  hold = 7.5 beats;  vel = 70;
    };
    sink { instrument = bass; };
};
